{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "types": ["node"],
    "noEmit": true,

    "skipLibCheck": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["./*.config.ts", "./oxlint.*.ts"]
}
