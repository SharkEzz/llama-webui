{
  "name": "llama-webui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "llama-webui": "dist/server/main.js"
  },
  "files": [
    "dist/server",
    "dist/web"
  ],
  "scripts": {
    "build": "vite build",
    "check": "pnpm -r --parallel --include-workspace-root typecheck",
    "dev": "node server/dev.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepack": "node scripts/prepack.ts",
    "release": "node scripts/release.ts",
    "site:build": "pnpm --filter llama-webui-site build",
    "site:dev": "pnpm --filter llama-webui-site dev",
    "site:preview": "pnpm --filter llama-webui-site preview",
    "start": "pnpm build && node dist/server/main.js",
    "test": "pnpm test:unit && pnpm --filter llamacpp-js test",
    "test:unit": "vitest run",
    "typecheck": "tsc -p scripts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "hono": "catalog:",
    "ws": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26.13"
  },
  "os": [
    "linux"
  ]
}
