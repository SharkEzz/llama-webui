{
  "name": "llama-webui",
  "version": "0.4.3",
  "private": true,
  "bin": {
    "llama-webui": "app/.output/llama-webui.mjs"
  },
  "files": [
    "app/.output"
  ],
  "os": [
    "linux"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @llama-webui/app build",
    "check": "pnpm -r --parallel --include-workspace-root typecheck",
    "dev": "pnpm --filter @llama-webui/app dev",
    "format": "oxfmt",
    "lint": "oxfmt --check && oxlint --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --fix && oxfmt",
    "profiling": "node scripts/profiling/cli.ts",
    "profiling:report": "node scripts/profiling/cli.ts report",
    "prepack": "node scripts/prepack.ts",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "release": "node scripts/release.ts",
    "site:build": "pnpm --filter llama-webui-site build",
    "site:dev": "pnpm --filter llama-webui-site dev",
    "site:preview": "pnpm --filter llama-webui-site preview",
    "start": "pnpm build && node app/.output/llama-webui.mjs",
    "test": "pnpm test:unit && pnpm --filter llamacpp-js test",
    "test:unit": "vitest run",
    "typecheck": "tsc -p . && tsc -p scripts"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-plugin-react-doctor": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "oxlint-tsgolint": "^7.0.2009",
    "puppeteer-core": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=26.13"
  },
  "packageManager": "pnpm@12.23.0"
}
