{
  "name": "llama-webui",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "check": "bun check --no-script && bun check -p web && bun run --cwd site typecheck",
    "compile": "bun scripts/compile.ts",
    "dev": "bun --hot server/index.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "release": "bun scripts/release.ts",
    "site:build": "bun run --cwd site build",
    "site:dev": "bun run --cwd site dev",
    "site:preview": "bun run --cwd site preview",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "^1.4.4",
    "bun-plugin-tailwind": "^0.1.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
