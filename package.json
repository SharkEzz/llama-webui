{
  "name": "llama-webui",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc -b && pnpm --filter llama-webui-site typecheck",
    "compile": "bun scripts/compile.ts",
    "dev": "bun --hot server/index.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "release": "bun scripts/release.ts",
    "site:build": "bun run --cwd site build",
    "site:dev": "bun run --cwd site dev",
    "site:preview": "bun run --cwd site preview",
    "start": "NODE_ENV=production bun server/index.ts",
    "test": "pnpm test:unit && pnpm --filter llamacpp-js test && pnpm test:bun",
    "test:bun": "bun test ./server ./scripts ./packages/webui-shared ./packages/llamacpp-js",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "^1.4.4",
    "@vitejs/plugin-react": "^6.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.19.0",
  "engines": {
    "node": ">=26.13"
  }
}
