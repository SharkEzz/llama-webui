{
  "name": "llama-webui",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "bin": {
    "llama-webui": "app/.output/llama-webui.mjs"
  },
  "files": [
    "app/.output"
  ],
  "scripts": {
    "build": "pnpm --filter @llama-webui/app build",
    "check": "pnpm -r --parallel --include-workspace-root typecheck",
    "dev": "pnpm --filter @llama-webui/app dev",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "prepack": "node scripts/prepack.ts",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "release": "node scripts/release.ts",
    "site:build": "pnpm --filter llama-webui-site build",
    "site:dev": "pnpm --filter llama-webui-site dev",
    "site:preview": "pnpm --filter llama-webui-site preview",
    "start": "pnpm build && node app/.output/llama-webui.mjs",
    "test": "pnpm test:unit && pnpm --filter llamacpp-js test",
    "test:unit": "vitest run",
    "typecheck": "tsc -p scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@effect/tsgo": "0.68.1",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "typescript-language-server": "^6.1.0",
    "vite": "catalog:",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13"
  },
  "os": [
    "linux"
  ]
}
