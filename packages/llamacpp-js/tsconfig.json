{
  // The library and its tests (tests/, node:test), as a Node user sees them: Node types only (no DOM), Node's own
  // module resolution, syntax Node can strip.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["src", "tests"]
}
