{
  // The web app and its tests. The typed API client (`@llama-webui/server/api`) brings the server's sources into this
  // project, hence Node's types next to the DOM's.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
