{
  // The client (`src/`, DOM) and the build scripts (`build/`, `vite.config.ts`, Node). The server has its own project
  // (`server/tsconfig.json`, Node only), which `typecheck` runs as well. During the Effect rewrite, only what the app
  // loads is checked: `main.tsx` and what it reaches, and the tests; the pages not ported yet stay as they are, and a
  // test that reaches one of them is excluded until its page is routed again at its milestone (Vitest still runs it).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/main.tsx", "src/*.d.ts", "src/**/*.test.ts", "src/**/*.test.tsx", "build", "vite.config.ts"],
  "exclude": ["src/lib/bench.test.ts", "src/lib/props.test.ts", "src/lib/tuning.test.ts"]
}
