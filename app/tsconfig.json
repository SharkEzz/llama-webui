{
  // The client (`src/`, DOM) and the build scripts (`build/`, `vite.config.ts`, Node). The server has its own project
  // (`server/tsconfig.json`, Node only), which `typecheck` runs as well.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "build", "vite.config.ts"]
}
