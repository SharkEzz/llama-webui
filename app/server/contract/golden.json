  },
  "GET /api/settings": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "binary": "llama-server",
      "host": "127.0.0.1",
      "port": "<port>",
      "modelsDir": "~/models",
      "pollIntervalMs": 1000,
      "historySeconds": 300,
      "hiddenGpus": [],
      "defaultProfileId": null,
      "onboardingDone": false,
