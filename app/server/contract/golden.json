      "hiddenGpus": [],
      "defaultProfileId": null,
      "llamaTuiImportDismissed": false,
      "onboardingDone": false,
      "collectors": {
        "nvml": true,
        "system": true,
        "disk": true
      },
      "theme": "system",
      "env": {}
    }
  }
}
