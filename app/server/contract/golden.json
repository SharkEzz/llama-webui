    "body": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/favicon-<hash>.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>llama-webui</title>\n    <script>\n      // Theme applied before rendering (no flash); same key as src/lib/theme.ts.\n      try {\n        const m = localStorage.getItem('llama-webui:theme');\n        const dark = m === 'dark' || (m !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n        document.documentElement.classList.toggle('dark', dark);\n        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';\n      } catch {\n        // localStorage unavailable: default theme\n      }\n    </script>\n    <script type=\"module\" crossorigin src=\"/assets/index-<hash>.js\"></script>\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/createLucideIcon-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/dist-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/hooks-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/button-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/ws-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/usingCtx-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/FloatingRootStore-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/usePositioner-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/useOpenInteractionType-<hash>.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/getPseudoElementBounds-<hash>.js\">\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-<hash>.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n"
  },
