{
  "GET /api/health": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "ok": true,
      "version": "<version>",
      "uptimeMs": "<uptimeMs>",
      "bootId": "<bootId>"
    }
  },
  "GET /api/settings": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "binary": "llama-server",
      "host": "127.0.0.1",
      "port": 8080,
      "modelsDir": "~/models",
      "pollIntervalMs": 1000,
      "historySeconds": 300,
      "hiddenGpus": [],
      "defaultProfileId": null,
      "llamaTuiImportDismissed": false,
      "onboardingDone": false,
      "collectors": {
        "nvml": true,
        "system": true,
        "disk": true
      },
      "theme": "system",
      "env": {}
    }
  },
  "GET /api/health (foreign Origin)": {
    "status": 403,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "_tag": "RequestRefused",
      "message": "Origin not allowed"
    }
  },
  "GET /api/health (Host evil.example)": {
    "status": 403,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "_tag": "RequestRefused",
      "message": "Host not allowed"
    }
  },
  "GET /api/nope": {
    "status": 404,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "_tag": "RouteNotFound",
      "message": "Unknown route"
    }
  },
  "GET /api/settings/ (trailing slash)": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "binary": "llama-server",
      "host": "127.0.0.1",
      "port": 8080,
      "modelsDir": "~/models",
      "pollIntervalMs": 1000,
      "historySeconds": 300,
      "hiddenGpus": [],
      "defaultProfileId": null,
      "llamaTuiImportDismissed": false,
      "onboardingDone": false,
      "collectors": {
        "nvml": true,
        "system": true,
        "disk": true
      },
      "theme": "system",
      "env": {}
    }
  },
  "DELETE /api/health (a method the path lacks)": {
    "status": 404,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "_tag": "RouteNotFound",
      "message": "Unknown route"
    }
  },
  "HEAD /api/health": {
    "status": 404,
    "headers": {
      "content-type": "application/json"
    }
  },
  "GET /ws (no upgrade)": {
    "status": 426,
    "headers": {
      "content-type": "text/plain;charset=utf-8"
    },
    "body": "WebSocket upgrade expected"
  },
  "GET / (the app)": {
    "status": 200,
    "headers": {
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-cache"
    },
    "body": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/favicon-<hash>.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>llama-webui</title>\n    <script>\n      // Theme applied before rendering (no flash); same key as src/lib/theme.ts.\n      try {\n        const m = localStorage.getItem('llama-webui:theme');\n        const dark = m === 'dark' || (m !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n        document.documentElement.classList.toggle('dark', dark);\n        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';\n      } catch {\n        // localStorage unavailable: default theme\n      }\n    </script>\n    <script type=\"module\" crossorigin src=\"/assets/index-<hash>.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-<hash>.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n"
  },
  "GET /chat/12 (deep URL)": {
    "status": 200,
    "headers": {
      "content-type": "text/html; charset=utf-8",
      "cache-control": "no-cache"
    },
    "body": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/assets/favicon-<hash>.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>llama-webui</title>\n    <script>\n      // Theme applied before rendering (no flash); same key as src/lib/theme.ts.\n      try {\n        const m = localStorage.getItem('llama-webui:theme');\n        const dark = m === 'dark' || (m !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);\n        document.documentElement.classList.toggle('dark', dark);\n        document.documentElement.style.colorScheme = dark ? 'dark' : 'light';\n      } catch {\n        // localStorage unavailable: default theme\n      }\n    </script>\n    <script type=\"module\" crossorigin src=\"/assets/index-<hash>.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-<hash>.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n  </body>\n</html>\n"
  },
  "GET /assets/index-<hash>.js (hashed asset)": {
    "status": 200,
    "headers": {
      "content-type": "text/javascript; charset=utf-8",
      "cache-control": "public, max-age=31536000, immutable"
    }
  },
  "GET /assets/index-00000000.js (missing asset)": {
    "status": 404,
    "headers": {}
  },
  "PATCH /api/settings (text/plain)": {
    "status": 415,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "_tag": "RequestRefused",
      "message": "JSON body expected (content-type: application/json)"
    }
  },
  "PATCH /api/settings (malformed JSON)": {
    "status": 400,
    "headers": {}
  },
  "PATCH /api/settings (schema violation)": {
    "status": 400,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "_tag": "SettingsInvalid",
      "message": "Invalid settings",
      "issues": [
        {
          "path": [
            "pollIntervalMs"
          ],
          "message": "Between 250 and 60000 ms"
        }
      ]
    }
  },
  "PATCH /api/settings": {
    "status": 200,
    "headers": {
      "content-type": "application/json"
    },
    "body": {
